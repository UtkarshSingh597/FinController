FINCONTROL_ENVIRONMENT=development
FINCONTROL_APP_NAME=FINCONTROL API
FINCONTROL_API_V1_PREFIX=/api/v1
FINCONTROL_CORS_ORIGINS=["http://localhost:3000"]
